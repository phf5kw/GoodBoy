pico-8 cartridge // http://www.pico-8.com
version 42
__lua__
--variables 
function _init()
	--poke(0x5f2c,3)
	player={
		sp=1,
		x=29,
		y=29,
		w=8,
		h=8,
		flp=false,
		dx=0,
		dy=0,
		max_dx=1.6,
		max_dy=2.5,
		acc=0.5,
		dec=0.7,
		boost=3,
		drop=3,
		anim=0,
		running=false,
		jumping=false,
		falling=false,
		landed=false,
		barreling=false,
		energy=50,
	}
	
	gravity=0.3
	friction=0.90
	depletion=0.01
end


-->8
--update and draw functions
function _update()
	player_update()
	player_animate()
	--simple camera
	--cam_x=player.x-64+(player.w/2)
	--camera(cam_x,0)
end

function _draw()
	cls()
	map(0,0)
	spr(player.sp,player.x,player.y,1,1,player.flp)
	print("running="..tostring(player.running),0,0,7)
	print("jumping="..tostring(player.jumping),0,6,7)
	print("falling="..tostring(player.falling),0,12,7)
	print("landed="..tostring(player.landed),0,18,7)
	flr1x=flr(player.x/8)
	flr2x=flr((player.x+player.w)/8)
	flry=flr((player.y+player.h)/8)
	print("flr="..tostring(flr1x).." "..tostring(flry),0,24,7)
	print("flr="..tostring(flr2x).." "..tostring(flry),0,30,7)
	
	--print("energy="..tostring(player.energy),0,24,7)
	--print("barreling="..tostring(player.barreling),0,30,7)
	
end
-->8
--collisions

function collide_map(obj,aim,flag)
	--obj = table needs x,y,w,h	
	--aim = left,right,up,down
	
	local x=obj.x local y=obj.y
	local w=obj.w local h=obj.h
		
	local x1=0 local y1=0
	local x2=0 local y2=0
	
	if aim=="left" then
		x1=x-1   y1=y
		x2=x					y2=y+h-1
	elseif aim=="right" then
		x1=x+w-1	y1=y
		x2=x+w			y2=y+h-1
	elseif aim=="up" then
		x1=x+2			y1=y-1
		x2=x+w-3	y2=y
	elseif aim=="down" then
		x1=x+2			y1=y+h
		x2=x+w-2	y2=y+h
	end
	
	--pixels to tiles
	x1/=8		y1/=8
	x2/=8		y2/=8
	
	if fget(mget(x1,y1),flag)
	or fget(mget(x1,y2),flag)
	or fget(mget(x2,y1),flag)
	or fget(mget(x2,y2),flag) then
		return true
	else
		return false
	end
	
end
-->8
--player

function player_update()
	--physics
	player.dy+=gravity
	player.dx*=friction
	--player.just_landed=false
	
	--controls
	if player.barreling then
		player.dx=0
	elseif btn(⬅️) then
		player.dx-=player.acc
		player.running=true
		player.flp=true
	elseif btn(➡️) then
		player.dx+=player.acc
		player.running=true
		player.flp=false
	else
		player.dx*=player.dec
	end

	--stop running
	if player.running
	and not btn(⬅️)
	and not btn(➡️)
	and player.landed then
		if player.dx < 0.01 then
			player.running=false
		end
	end
	
	--jump
	if btnp(❎)
	and player.landed then
		player.dy-=player.boost
		player.landed=false
		player.energy-=2
	end
	
	--barrel
	if btn(🅾️)
	and not player.landed then
		player.dy+=player.drop
		player.dx=0
		player.energy-=4
		player.jumping=false
		player.falling=false
		player.barreling=true
	end
	
	--check collision up and down
	if player.dy>0 then
		local max_dy=player.max_dy
		if not player.barreling then
			player.falling=true
		else
			max_dy=9
		end
		player.landed=false
		player.jumping=false
		
		player.dy=limit_speed(player.dy,max_dy)
		
		if collide_map(player,"down",2) and player.barreling then
			flr1x=flr(player.x/8)
			flr2x=flr((player.x+player.w)/8)
			flry=flr((player.y+player.h)/8)
			if fget(mget(flr1x,flry),2) then
				mset(flr1x,flry,0) --destroy
			end
			if fget(mget(flr2x,flry),2) then
				mset(flr2x,flry,0) --destroy
			end	
		elseif collide_map(player,"down",0) then
			player.landed=true
			player.falling=false
			player.barreling=false
			player.dy=0
			player.y-=(player.y+player.h)%8
		end
	elseif player.dy<0 then
		player.jumping=true
		if collide_map(player,"up",1) then
			player.dy=0
		end
	end
	
	--check collision left and right
	if player.dx<0 then
	
		player.dx=limit_speed(player.dx,player.max_dx)
	
		if collide_map(player,"left",1) then
			player.dx=0
		end
	elseif player.dx>0 then
	
		player.dx=limit_speed(player.dx,player.max_dx)
		
		if collide_map(player,"right",1) then
			player.dx=0
		end
	end
	
	player.x+=player.dx
	player.y+=player.dy
	
	--energy
	player.energy-=depletion
	
end

--animation
function player_animate()
	if player.jumping then
		player.sp=6
		if player.dy>1 then
			player.sp=7
		end
	elseif player.falling then
		player.sp=7
		if player.dy>1 then
			player.sp=8
		end
	--elseif player.just_landed then
		--player.sp=10
	elseif player.barreling then
		player.sp=10
	elseif player.running then
		if time()-player.anim>.12 then
			player.anim=time()
			if player.sp==4 then
				player.sp=3
			else
				player.sp=4
			end
		end
	else --idle
		if time()-player.anim>.3 then
			player.anim=time()
			if player.sp==1 then
				player.sp=2
			else
				player.sp=1
			end
		end
	end
end

function limit_speed(num,maximum)
	return mid(-maximum,num,maximum)
end
