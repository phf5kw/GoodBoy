pico-8 cartridge // http://www.pico-8.com
version 42
__lua__
--variables 
game={}

function _init()
	--poke(0x5f2c,3)
	
	player={
		sp=1,
		x=29,
		y=29,
		w=8,
		h=8,
		flp=false,
		dx=0,
		dy=0,
		max_dx=1.5,
		max_dy=2.5,
		acc=0.5,
		dec=0.7,
		boost=3,
		drop=3,
		anim=0,
		running=false,
		jumping=false,
		falling=false,
		landed=false,
		barreling=false,
		power=false,
		energy=100,
		score=0,
		
		barrel_play=false, --idk
	}
	
	gravity=0.3
	friction=0.90
	depletion=0.005
	
	cam_init()
	show_game()
	game.start_t=time()
	
end


-->8
--main update draw functions

function _update()
	game.upd()
end

function _draw()
	game.drw()
end

---game update and draw---

function show_game()
	game.upd=game_update
	game.drw=game_draw
end

function game_draw()
	cls()
	map(0,0)
	print("arrow keys",3,54,10)
	print("to move",3,60,10)
	print("⬆️+z to",98,54,10)
	print("special",98,60,10)
	spr(player.sp,player.x,player.y,1,1,player.flp)
	print_update()
	
end

function game_update()
	player_update()
	player_animate()
	cam_update()
end

function end_game()
	game.end_t=time()
	sfx(-1,1)
	game.upd=end_upd 
	game.drw=end_drw
end

function end_upd()
	return
end

function end_drw()
	cls()
	camera(0,0)
	if time()-game.end_t>1 then
		print("you did it! you found",14,20,7)
		print("the biggest bone!",14,27,7)
	end
	if time()-game.end_t>4 then
		print("i am so proud of you...",14,37,7)
	end
	if time()-game.end_t>7 then
		print("you really are",14,47,7)
		print("the goodest boy!♥",14,54,7)
	end
	if time()-game.end_t>10 then
		print("total score: "..player.score,14,64,10)
	end
	if time()-game.end_t>13 then
		print("total time: "..tostring(flr(100*(game.end_t-game.start_t))/100),14,71,6)
	end
	if time()-game.end_t>16 then
		print("thanks for playing!",14,81,7)
	end
	if time()-game.end_t>18 then
		print("join student game developers,",14,91,12)	
		print("the uva game dev club!",14,97,12)
	end
	if time()-game.end_t>25 then
		stop()
	end	
end
-->8
--collisions

function collide_map(obj,aim,flag)
	--obj = table needs x,y,w,h	
	--aim = left,right,up,down
	
	local x=obj.x local y=obj.y
	local w=obj.w local h=obj.h
		
	local x1=0 local y1=0
	local x2=0 local y2=0
	
	if aim=="left" then
		x1=x-1   y1=y
		x2=x					y2=y+h-1
	elseif aim=="right" then
		x1=x+w-1	y1=y
		x2=x+w			y2=y+h-1
	elseif aim=="up" then
		x1=x+2			y1=y-1
		x2=x+w-3	y2=y
	elseif aim=="down" then
		x1=x+2			y1=y+h
		x2=x+w-2	y2=y+h
	end
	
	--pixels to tiles
	x1/=8		y1/=8
	x2/=8		y2/=8
	
	if fget(mget(x1,y1),flag)
	or fget(mget(x1,y2),flag)
	or fget(mget(x2,y1),flag)
	or fget(mget(x2,y2),flag) then
		return true
	else
		return false
	end
	
end

--delete from any direction
function del_mapobj(obj,flag)
	collide=false
	local x1=0 local y1=0
	local x2=0 local y2=0
	x1=obj.x			x2=obj.x+obj.w
	y1=obj.y			y2=obj.y+obj.h
	
	--pixels to tiles
	x1/=8		y1/=8
	x2/=8		y2/=8
	
	if fget(mget(x1,y1),flag) then
		mset(flr(x1),flr(y1),0)
		collide=true
	end
	if fget(mget(x1,y2),flag) then
		mset(flr(x1),flr(y2),0)
		collide=true
	end
	if fget(mget(x2,y1),flag) then
		mset(flr(x2),flr(y1),0)
		collide=true
	end
	if fget(mget(x2,y2),flag) then
		mset(flr(x2),flr(y2),0)
		collide=true
	end
	return collide
end
-->8

--player update

function player_update()
	--sound stuff?

	--physics
	player.dy+=gravity
	player.dx*=friction
	
	max_dy=player.max_dy
	max_dx=player.max_dx
	acc=player.acc 
	boost=player.boost
	
	if player.power then
		max_dy=8.5
		max_dx=2
		acc=2
		boost=4
	elseif player.barreling then
		max_dy=7
	end
	
	--controls
	if player.barreling then
		player.dx=0
	elseif btn(⬅️) then
		player.dx-=acc
		player.running=true
		player.flp=true
	elseif btn(➡️) then
		player.dx+=acc
		player.running=true
		player.flp=false
	else
		player.dx*=player.dec
	end

	--stop running
	if player.running
	and not btn(⬅️)
	and not btn(➡️)
	and player.landed then
		if player.dx < 0.01 then
			player.running=false
		end
	end
	
	--jump
	if btnp(⬆️)
	and player.landed then
		player.dy-=boost
		player.landed=false
		player.energy-=1
		sfx(0,2)
	end
	
	--barrel
	if btn(🅾️)
	and not player.landed then
		player.dy+=player.drop
		player.dx=0
		player.jumping=false
		player.falling=false
		player.barreling=true
		if stat(52)==-1 then
			sfx(5,2)
		end
	end
	
	if player.barreling then
		player.energy-=0.3
	end
	
	--check collision up and down
	if player.dy>0 then
		
		if not player.barreling then
			player.falling=true
		end
		player.landed=false
		player.jumping=false
		
		player.dy=limit_speed(player.dy,max_dy)
		
		if collide_map(player,"down",2) and player.barreling then
			flr1x=flr(player.x/8)
			flr2x=flr((player.x+player.w)/8)
			flry=flr((player.y+player.h)/8)
			local bg=0
			if flr(player.x/128)*128<1 and flr(player.y/128)*128<1 then
				bg=58 --set dirt instead
			end
			if fget(mget(flr1x,flry),2) then
				mset(flr1x,flry,bg) --destroy
			end
			if fget(mget(flr2x,flry),2) then
				mset(flr2x,flry,bg) --destroy
			end
		elseif collide_map(player,"down",0) then	
			if not barrel_play and player.barreling then
				sfx(6,2)
				barrel_play=true
			end
			player.landed=true
			player.falling=false
			player.barreling=false
			player.dy=0
			player.y-=(player.y+player.h)%8
		end
	elseif player.dy<0 then
		barrel_play=false
		player.jumping=true
		if collide_map(player,"up",1) then
			player.dy=0
		end
	end
	
	--check collision left and right
	if player.dx<0 then
	
		player.dx=limit_speed(player.dx,max_dx)
	
		if collide_map(player,"left",1) then
			player.dx=0
		end
	elseif player.dx>0 then
	
		player.dx=limit_speed(player.dx,max_dx)
		
		if collide_map(player,"right",1) then
			player.dx=0
		end
	end
	
	--quad teleport
	if player.y>=63*8 then
		player.y=0
		player.x+=128
	end
	
	
	player.x+=player.dx
	player.y+=player.dy
	
	if player.x<0 then
		player.x=0
	end
	
	----item collisions----
	
	--bone
	if del_mapobj(player,3) then
		player.score+=5
		sfx(1,1)
	end
	
	--big bone
	if del_mapobj(player,4) then
		player.score+=15
		sfx(2,1)
	end
	
	--sausage :)
	if del_mapobj(player,5) then
		player.energy+=20
		sfx(3,1)
	end
	
	--powerup
	if del_mapobj(player,6) then
		player.power=true
		sfx(4,1)
	end
	
	--final bone
	if del_mapobj(player,7) then
		sfx(2,1)
		end_game()
	end
	
	--energy
	if not player.power then
		player.energy-=depletion
	end
	
end

function limit_speed(num,maximum)
	return mid(-maximum,num,maximum)
end
-->8
--player animation
function player_animate()
	offset=0
	if player.power then
		offset=16
	end

	if player.jumping then
		player.sp=6+offset
		if player.dy>1 then
			player.sp=7+offset
		end
	elseif player.falling then
		player.sp=7+offset
		if player.dy>1 then
			player.sp=8+offset
		end
	elseif player.barreling then
		player.sp=10+offset
	elseif player.running then
		if time()-player.anim>.12 then
			player.anim=time()
			if player.sp==4 or player.sp==4+offset then
				player.sp=3+offset
			else
				player.sp=4+offset
			end
		end
	else --idle
		if time()-player.anim>.3 then
			player.anim=time()
			if player.sp==1 or player.sp==1+offset then
				player.sp=2+offset
			else
				player.sp=1+offset
			end
		end
	end
end
-->8
--camera_update

function cam_init()
	camx=flr(player.x/128)*128 
	camy=flr(player.y/128)*128
	newcamx=camx newcamy=camy
end

function cam_update()

	newcamx=flr(player.x/128)*128 
	newcamy=flr(player.y/128)*128
	
	--instant transition if ylim hit
	if newcamx!=camx then
		camx=newcamx
		camy=newcamy
	elseif newcamy!=camy then
		--move y every screen down 
		camy+=16*sgn(newcamy-camy)
	end
	
	camera(camx,camy)
	--show score
	
end

-->8
--print statements
function print_update()
	print("p.y="..tostring(player.y),player.x,player.y-4,7)
	yquad=flr(player.y/(128))
	--print("yquad="..tostring(yquad),player.x,player.y-10,7)
	print("landed="..tostring(player.landed),player.x,player.y-10,7)

	--print score
	xquad=flr(player.x/128)*128 
	yquad=flr(player.y/128)*128
	print("score="..tostring(player.score),camx+1,camy+1,7)
	
end

